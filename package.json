{
  "name": "sda-chms",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "vp check --fix",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down",
    "dev": "vp -C apps/chms run dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:e2e": "playwright test",
    "db:seed": "pnpm --dir apps/chms run db:seed",
    "db:migrate": "pnpm --dir apps/chms exec void db migrate",
    "db:generate": "pnpm --dir apps/chms exec void db generate",
    "prepare": "node scripts/prepare.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@sda-chms/config": "workspace:*",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "ultracite": "7.8.3",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@10.15.0"
}
