{
  "name": "sda-chms",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "vp check --fix",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down",
    "dev": "vp run dev:web",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:e2e": "playwright test",
    "db:migrate": "pnpm --dir apps/web exec void db migrate",
    "prepare": "node scripts/prepare.mjs",
    "sandcastle": "pnpm exec tsx .sandcastle/main.ts",
    "sandcastle:pr-comments": "pnpm exec tsx .sandcastle/address-comments.ts"
  },
  "dependencies": {
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.10.0",
    "@playwright/test": "^1.61.1",
    "@sda-chms/config": "workspace:*",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "ultracite": "7.8.3",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@10.15.0"
}
