{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    // The app predates the root config fold and has never been checked with
    // this rule; enabling it needs code changes outside a path-only rename.
    "noUncheckedIndexedAccess": false,
    "types": ["vite/client"],
    "rootDirs": ["."],
    "paths": {
      // Restated from .void/tsconfig.json instead of extending it: extending
      // inherits its `files` (restricting the program to three .d.ts files, so
      // src/ is never checked) and compilerOptions.paths does not merge.
      "@/*": ["./src/*"],
      "void/db": ["./.void/db.d.ts"],
      "void/routes": ["./.void/routes.d.ts"],
      "@schema": ["./src/db/schema.ts"],
      "@schema/*": ["./src/db/schema/*"]
    }
  }
}
