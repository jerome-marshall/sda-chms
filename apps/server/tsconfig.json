{
  "extends": "@sda-chms/config/tsconfig.base.json",
  "compilerOptions": {
    // Interim: composite is off until apps/server is deleted. The server code
    // moved to apps/web/server but the old Hono routes still import it, and a
    // composite project cannot span both packages.
    "composite": false,
    // Interim: the moved code lives outside this package until apps/server is
    // deleted. Widened so the old routes typecheck against it (noEmit only).
    "rootDir": "../..",
    "outDir": "dist",
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "strictNullChecks": true,
    // Interim: server code moved to apps/web/server but the old Hono routes
    // still import it until apps/server is deleted. Resolve the web aliases
    // the moved code uses.
    "paths": {
      "void/db": ["../web/.void/db.d.ts"],
      "@schema": ["../web/db/schema.ts"],
      "@schema/*": ["../web/db/schema/*"]
    }
  },
  "exclude": ["dist", "**/*.test.ts", "vite.config.ts"]
}
